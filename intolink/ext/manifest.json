{
  "manifest_version": 3,
  "name": "송파바로 인투링크 연동",
  "version": "3.2",
  "description": "인투링크 진료대기·입원/호텔 목록을 케어 노트와 연동 (읽기만 함)",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen",
    "alarms",
    "background"
  ],
  "host_permissions": [
    "https://intolink.co.kr/*",
    "https://*.intolink.co.kr/*",
    "https://securetoken.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://intolink.co.kr/*",
        "https://*.intolink.co.kr/*"
      ],
      "js": [
        "ua.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "송파바로 인투링크 연동",
    "default_popup": "popup.html"
  }
}