{
  "manifest_version": 3,
  "name": "송파바로 인투링크 연동",
  "version": "1.5",
  "description": "인투링크 진료대기·입원/호텔 목록을 케어 노트와 연동 (1.3: 연동 미리보기, 케어 노트로는 아직 보내지 않음)",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "https://intolink.co.kr/*",
    "https://*.intolink.co.kr/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://intolink.co.kr/*",
        "https://*.intolink.co.kr/*"
      ],
      "js": [
        "ua.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "송파바로 인투링크 연동",
    "default_popup": "popup.html"
  }
}