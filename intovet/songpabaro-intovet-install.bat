@echo off
title SongpaBaro IntoVet button setup
set D=%LOCALAPPDATA%\songpabaro-intovet
if /i "%~1"=="remove" goto rm
if not exist "%D%" mkdir "%D%"
>"%D%\go.vbs" echo CreateObject("WScript.Shell").Run "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand ", 0, False
reg add "HKCU\Software\Classes\sbintovet" /ve /d "URL:SongpaBaro IntoVet" /f >nul
reg add "HKCU\Software\Classes\sbintovet" /v "URL Protocol" /d "" /f >nul
reg add "HKCU\Software\Classes\sbintovet\shell\open\command" /ve /d "wscript.exe \"%D%\go.vbs\" \"%%1\"" /f >nul
echo.
echo  [OK] IntoVet button installed on this PC.
echo  Press the hospital button on the care note chat window.
echo  If Chrome asks, check "Always allow" and press Open.
echo.
pause
exit /b
:rm
reg delete "HKCU\Software\Classes\sbintovet" /f >nul 2>&1
echo  Removed.
pause
